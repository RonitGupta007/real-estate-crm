generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Property {
  id              String      @id @default(cuid())
  title           String
  slug            String      @unique
  address         String
  city            String
  state           String
  zipCode         String
  country         String      @default("India")
  price           Float
  propertyType    String      // APARTMENT_3BHK, APARTMENT_4BHK, LUXURY_PENTHOUSE, GATED_VILLA, PLOT_LAND, COMMERCIAL_OFFICE
  status          String      @default("ACTIVE") // ACTIVE, PENDING, UNDER_CONTRACT, SOLD, OFF_MARKET
  listingType     String      @default("FOR_SALE") // FOR_SALE, FOR_RENT
  bedrooms        Int
  bathrooms       Float
  squareFeet      Int
  yearBuilt       Int?
  lotSize         String?
  reraId          String?     // RERA Registration Number (e.g. MahaRERA / HARERA / Karnataka RERA)
  bhkConfig       String?     // 3 BHK, 4 BHK, 5 BHK Penthouse, etc.
  facingDirection String?     // East Facing, North Facing (Vastu Compliant)
  maintenanceCharges Float?   // Monthly Society Maintenance (₹/month)
  description     String
  images          String      // JSON array of image URLs
  featuredImage   String
  features        String      // JSON array of amenity tags: Pool, Clubhouse, Power Backup, etc.
  hoaFees         Float?
  pricePerSqFt    Float?
  assignedAgent   String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  deals           Deal[]
  showings        Showing[]
  activities      Activity[]
  interestedLeads LeadPropertyInterest[]
  followUps       FollowUp[]
  documents       Document[]
}

model Lead {
  id                String      @id @default(cuid())
  firstName         String
  lastName          String
  email             String      @unique
  phone             String
  type              String      @default("BUYER") // BUYER, SELLER, INVESTOR, AGENT, RENTER
  status            String      @default("NEW") // NEW, CONTACTED, QUALIFIED, SHOWING, NEGOTIATING, WON, LOST
  source            String      @default("MAGICBRICKS") // MAGICBRICKS, 99ACRES, HOUSING_COM, WHATSAPP, REFERRAL, WALK_IN, WEBSITE
  budgetMin         Float?
  budgetMax         Float?
  preferredLocation String?
  preferredType     String?
  priority          String      @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  notes             String?
  assignedAgent     String      @default("Priya Sharma")
  lastContactedAt   DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  deals             Deal[]
  showings          Showing[]
  activities        Activity[]
  properties        LeadPropertyInterest[]
  followUps         FollowUp[]
  documents         Document[]
}

model LeadPropertyInterest {
  id          String   @id @default(cuid())
  leadId      String
  propertyId  String
  interest    String   @default("INTERESTED") // FAVORITE, VIEWED, OFFER_MADE
  createdAt   DateTime @default(now())

  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([leadId, propertyId])
}

model Deal {
  id                 String    @id @default(cuid())
  title              String
  stage              String    @default("DISCOVERY") // DISCOVERY, SHOWING, OFFER_SUBMITTED, UNDER_CONTRACT, CLOSING, CLOSED_WON, CLOSED_LOST
  dealValue          Float
  expectedCommission Float
  commissionRate     Float     @default(2.0)
  closeDate          DateTime?
  probability        Int       @default(50) // 0 - 100
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  leadId             String?
  lead               Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)

  propertyId         String?
  property           Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  activities         Activity[]
  followUps          FollowUp[]
  documents          Document[]
}

model Showing {
  id          String   @id @default(cuid())
  title       String
  type        String   @default("PROPERTY_VIEWING") // PROPERTY_VIEWING, OPEN_HOUSE, CLIENT_MEETING, INSPECTION, CLOSING
  startTime   DateTime
  endTime     DateTime
  status      String   @default("SCHEDULED") // SCHEDULED, CONFIRMED, COMPLETED, CANCELLED
  location    String?
  notes       String?
  feedback    String?
  agentName   String   @default("Priya Sharma")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leadId      String?
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  propertyId  String?
  property    Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
}

model Activity {
  id          String   @id @default(cuid())
  type        String   @default("NOTE") // NOTE, CALL, EMAIL, MEETING, STAGE_CHANGE, SHOWING
  title       String
  description String
  createdAt   DateTime @default(now())

  leadId      String?
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  propertyId  String?
  property    Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  dealId      String?
  deal        Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
}

model FollowUp {
  id               String    @id @default(cuid())
  type             String    // POST_SHOWING, STALE_LEAD, NEW_MATCH, OFFER_CHECKIN, MILESTONE
  urgency          String    @default("HIGH") // URGENT, HIGH, MEDIUM, LOW
  reason           String
  suggestedChannel String    @default("EMAIL") // EMAIL, SMS, CALL_SCRIPT
  draftSubject     String?
  draftContent     String
  status           String    @default("PENDING") // PENDING, SENT, DISMISSED
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  leadId           String
  lead             Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  propertyId       String?
  property         Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  dealId           String?
  deal             Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
}

model Document {
  id          String    @id @default(cuid())
  title       String
  category    String    // CONTRACT, TITLE, INSPECTION, HOA, WIRE, FLOORPLAN
  fileSize    String    @default("2.4 MB")
  fileUrl     String    @default("#")
  createdAt   DateTime  @default(now())

  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  propertyId  String?
  property    Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  dealId      String?
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
}
